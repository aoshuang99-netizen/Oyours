# ═══════════════════════════════════════════════════════════════
#  Matrix-Link 2026 — Environment Configuration
#  复制此文件为 .env 并填入实际值
# ═══════════════════════════════════════════════════════════════

# ── MySQL 数据库 ─────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=affiliate_system
MYSQL_DATA_DIR=./mysql-data
MYSQL_BASE_DIR=./mysql-8.0.41-winx64

# ── Express 网关 ─────────────────────────────────────────────
PORT=3000
# 联盟变现落地页基础 URL（真实跳转目标）
LANDING_BASE=https://your-affiliate-offer.com/checkout

# ── FFmpeg 视频处理 ─────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# 编码预设：ultrafast | veryfast | fast | medium（DD.txt 建议 ultrafast）
FFMPEG_PRESET=ultrafast

# ── Nginx 反向代理 ──────────────────────────────────────────
NGINX_ENABLED=1
# Let's Encrypt 证书路径（生产环境）
# SSL_CERT=/etc/letsencrypt/live/yourdomain/fullchain.pem
# SSL_KEY=/etc/letsencrypt/live/yourdomain/privkey.pem

# ── Playwright 群控客户端 ───────────────────────────────────
# Cookie 快照目录
COOKIE_DIR=./cookies
# 持久化 Profile 目录（DD.txt: ./profiles）
PROFILE_DIR=./profiles

# ── 代理服务器（格式：http://user:pass@ip:port） ──────────
# 示例：
# PROXY_SERVER=http://residential-user:pass@gate.example.com:8080

# ── 批量任务配置 ────────────────────────────────────────────
# 并发 worker 数
BATCH_CONCURRENCY=2
# 页面驻留时间 (ms)
DWELL_MS=30000
